<Window x:Class="AetherDrop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AetherDrop"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="AetherDrop" Width="420" Height="712"
        WindowStartupLocation="Manual" ResizeMode="NoResize" ShowInTaskbar="True" AllowDrop="True"
        Foreground="{DynamicResource Text}" FontFamily="{DynamicResource UiFont}" FontSize="13">
  <Grid x:Name="Root">
    <Grid.RowDefinitions>
      <RowDefinition Height="{x:Static local:UiLayout.MainTitleBarRow}"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="52"/>
    </Grid.RowDefinitions>

    <!-- Title bar -->
    <Border Grid.Row="0" Padding="{x:Static local:UiLayout.HeaderPadding}">
      <Grid x:Name="HeaderGrid">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="SettingsButton" Style="{StaticResource TitleButton}" Click="Settings_Click" ToolTip="{local:T main.settings}"
                  AutomationProperties.Name="{local:T main.settings}">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" FontSize="14"/>
          </Button>
          <Border Width="1" Height="14" Background="{DynamicResource Border}" Margin="4,0"/>
          <Button Style="{StaticResource CloseTitleButton}" Click="Close_Click" AutomationProperties.Name="Close">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE8BB;" FontSize="10"/>
          </Button>
        </StackPanel>
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <Image x:Name="Mark" Source="{x:Static local:Branding.TrayPanelLogo}" Width="24" Height="24" Margin="3,0,7,0" Stretch="Uniform"
                 RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="False"/>
          <TextBlock Text="AetherDrop" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Quick controls under the status pill -->
    <Popup local:UiMotion.Popover="True" x:Name="StatusPopup" PlacementTarget="{Binding ElementName=StatusPill}" Placement="Custom" VerticalOffset="6"
           StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" Closed="StatusPopup_Closed">
      <Grid x:Name="StatusPopupSurface" Width="264" Margin="10">
        <Border CornerRadius="12" Background="{DynamicResource MicaSolid}" IsHitTestVisible="False"><Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.14"/></Border.Effect></Border>
      <Border x:Name="StatusPopupCard" CornerRadius="12" Padding="12" Background="{DynamicResource MicaSolid}" BorderBrush="{DynamicResource BorderStrong}"
              BorderThickness="1">

        <ScrollViewer x:Name="QuickControlsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <DockPanel>
            <CheckBox x:Name="AllowToggle" DockPanel.Dock="Right" Style="{StaticResource WinToggle}" Click="Allow_Click"/>
            <TextBlock Text="{local:T tray.receive}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
          </DockPanel>
          <Border Style="{StaticResource Rule}" Margin="0,10,0,8"/>
          <TextBlock Text="{local:T recv.scope}" Style="{StaticResource Dim11}" Margin="0,0,0,4"/>
          <StackPanel x:Name="ReceiveList"/>
          <TextBlock x:Name="ReceiveTip" Style="{StaticResource Dim11}" TextWrapping="Wrap" Margin="0,6,0,0"/>
          <Border Style="{StaticResource Rule}" Margin="0,10,0,8"/>
          <TextBlock Text="{local:T tray.mode}" Style="{StaticResource Dim11}" Margin="0,0,0,4"/>
          <StackPanel x:Name="ModeList"/>
          <Border Style="{StaticResource Rule}" Margin="0,8,0,8"/>
          <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="{local:T tray.report}" Click="Report_Click" FontSize="11"/>
            <TextBlock x:Name="ChannelTip" Style="{StaticResource Dim11}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0"/>
          </DockPanel>
        </StackPanel>
        </ScrollViewer>
      </Border>
      </Grid>
    </Popup>

    <!-- A newer version -->
    <Border x:Name="UpdateBar" Grid.Row="1" Background="{DynamicResource AccentSubtle}" BorderBrush="{DynamicResource Border}"
            BorderThickness="0,0,0,1" Padding="16,8" Visibility="Collapsed">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Style="{StaticResource WinPrimary}" Content="{local:T update.now}" Click="UpdateNow_Click" Padding="10,5"/>
          <Button Style="{StaticResource WinButton}" Content="{local:T update.later}" Click="UpdateLater_Click" Padding="8,5" Margin="6,0,0,0"/>
        </StackPanel>
        <TextBlock x:Name="UpdateText" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      </DockPanel>
    </Border>

    <!-- Content -->
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="{x:Static local:UiLayout.PageMargin}">
        <!-- Nearby devices -->
        <Grid x:Name="NearbyPanel">
          <local:RadarView x:Name="MainRadar" local:UiLayout.AdaptiveRadar="True" Height="408"/>
          <!-- Status pill: opens the quick controls -->
          <ToggleButton HorizontalAlignment="Right" VerticalAlignment="Top" Height="28" Margin="0,1,0,0" MaxWidth="240" Foreground="{DynamicResource Text}" x:Name="StatusPill" shell:WindowChrome.IsHitTestVisibleInChrome="True" Cursor="Hand" FocusVisualStyle="{x:Null}"
                        Checked="StatusPill_Checked">
            <ToggleButton.Template>
              <ControlTemplate TargetType="ToggleButton">
                <Border x:Name="b" CornerRadius="12" Padding="10,4" Background="{DynamicResource Card}" BorderThickness="0">
                  <ContentPresenter/>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsChecked" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource AccentSubtle}"/></Trigger>
                  <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource CardHover}"/></Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </ToggleButton.Template>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Ellipse x:Name="StatusDot" Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0"/>
              <TextBlock Grid.Column="1" x:Name="StatusText" FontSize="12" MaxWidth="150" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="2" Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="8" Foreground="{DynamicResource Text3}" Margin="6,1,0,0"/>
            </Grid>
          </ToggleButton>
        </Grid>

        <!-- Files to send: dashed while empty -->
        <Grid Margin="0,16,0,0">
          <Rectangle x:Name="FilesOutline" RadiusX="8" RadiusY="8" Stroke="{DynamicResource BorderStrong}" StrokeThickness="1"
                     Fill="{DynamicResource Card}"/>
          <StackPanel Margin="16,12">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource WinButton}" Content="{local:T main.add}" Click="Add_Click"/>
                <Button x:Name="ClearButton" Style="{StaticResource QuietButton}" Content="{local:T main.clear}" Click="Clear_Click" Margin="4,0,0,0"/>
              </StackPanel>
              <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE8A5;" Foreground="{DynamicResource Text2}" Margin="0,0,8,0"
                         VerticalAlignment="Center"/>
              <TextBlock Text="{local:T main.dropHint}" FontSize="12" Foreground="{DynamicResource Text2}" TextWrapping="Wrap"
                         VerticalAlignment="Center" Margin="0,0,8,0"/>
            </DockPanel>
            <DockPanel x:Name="FilesRow" Margin="0,10,0,0">
              <TextBlock x:Name="FilesCount" DockPanel.Dock="Right" Style="{StaticResource Dim11}" VerticalAlignment="Bottom" Margin="8,0,0,4"/>
              <ItemsControl ItemsSource="{Binding Files}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{DynamicResource CardHover}" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1"
                            CornerRadius="6" Padding="10,3,4,3" Margin="0,0,6,6" ToolTip="{Binding}">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{local:T file.generic}" FontSize="12" MaxWidth="150"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource TitleButton}" Width="20" Height="20" Tag="{Binding}" Click="RemoveFile_Click" Margin="4,0,0,0"
                                AutomationProperties.Name="Remove">
                          <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="9"/>
                        </Button>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </DockPanel>
          </StackPanel>
        </Grid>

        <!-- Recently received -->
        <TextBlock Text="{local:T main.received}" Style="{StaticResource H14}" Margin="0,24,0,8"/>
        <TextBlock x:Name="NothingReceived" Text="{local:T main.receivedNone}" Style="{StaticResource Dim11}" FontSize="12" Margin="0,0,0,4"/>
        <ItemsControl x:Name="ReceivedList">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="local:Received">
              <Border x:Name="card" Style="{StaticResource WinCard}" Padding="12" Margin="0,0,0,8">
                <DockPanel>
                  <Button x:Name="open" DockPanel.Dock="Right" Style="{StaticResource WinButton}" Content="{local:T main.open}"
                          Tag="{Binding Path}" Click="Open_Click" Padding="10,4" FontSize="11" Margin="8,0,0,0"/>
                  <TextBlock x:Name="glyph" DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE896;" Foreground="{DynamicResource Accent}" Margin="0,0,10,0"/>
                  <TextBlock FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                    <Run Text="{Binding From, Mode=OneWay}" FontWeight="Bold"/><Run Text=" · " Foreground="{DynamicResource Text3}"/><Run
                         Text="{local:T file.received}" Foreground="{DynamicResource Text3}"/><Run Text=" · " Foreground="{DynamicResource Text3}"/><Run
                         x:Name="tail" Text="{Binding WhenText, Mode=OneWay}" Foreground="{DynamicResource Text3}"/>
                  </TextBlock>
                </DockPanel>
              </Border>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Failed}" Value="True">
                  <Setter TargetName="open" Property="Visibility" Value="Collapsed"/>
                  <Setter TargetName="glyph" Property="Text" Value="&#xE783;"/>
                  <Setter TargetName="glyph" Property="Foreground" Value="{DynamicResource Error}"/>
                  <Setter TargetName="tail" Property="Text" Value="{local:T main.incomplete}"/>
                  <Setter TargetName="tail" Property="Foreground" Value="{DynamicResource Error}"/>
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

    <!-- Footer: where received files go -->
    <Border Grid.Row="3" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="{x:Static local:UiLayout.FooterPadding}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Style="{StaticResource LinkButton}" Content="{local:T main.change}" Click="ChangeFolder_Click"/>
          <Button Style="{StaticResource LinkButton}" Content="{local:T main.openFolder}" Click="OpenFolder_Click" Margin="12,0,0,0"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="13" Foreground="{DynamicResource Text2}" Margin="0,0,8,0"/>
          <TextBlock x:Name="FolderText" FontSize="12" Foreground="{DynamicResource Text2}" TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center" MaxWidth="200"/>
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</Window>
