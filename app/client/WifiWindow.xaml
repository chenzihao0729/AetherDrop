<Window x:Class="NekoDrop.WifiWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NekoDrop"
        Title="{local:T wifi.title}" Width="420" Height="620" MinWidth="360" MinHeight="420"
        Icon="{x:Static local:Branding.WindowIcon}"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Window}" Foreground="{DynamicResource Text}"
        FontFamily="{DynamicResource UiFont}" FontSize="14">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="SettingsStyles.xaml"/></ResourceDictionary.MergedDictionaries>
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Flat" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Background" Value="{DynamicResource Card}"/>
      <Setter Property="Padding" Value="14,5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource CardStroke}"
                    BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource CardHover}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Flat}">
      <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
      <Setter Property="Background" Value="{DynamicResource Accent}"/>
    </Style>
    </ResourceDictionary>
  </Window.Resources>

  <Grid Margin="20,16,20,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Current connection -->
    <Border Grid.Row="0" Background="{DynamicResource Card}" BorderBrush="{DynamicResource CardStroke}" BorderThickness="1"
            CornerRadius="8" Padding="14,12">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="RefreshButton" Content="{local:T wifi.refresh}" Style="{StaticResource Flat}" Click="Refresh_Click"/>
          <Button x:Name="DisconnectButton" Content="{local:T wifi.disconnect}" Style="{StaticResource Flat}" Click="Disconnect_Click" Margin="8,0,0,0"/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Left" x:Name="StateGlyph" FontFamily="{DynamicResource IconFont}" Text="&#xE701;" FontSize="22"
                   Foreground="{DynamicResource AccentText}" VerticalAlignment="Center" Margin="0,0,12,0"/>
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="StateTitle" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="StateDetail" Style="{StaticResource Caption}"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <TextBlock Grid.Row="1" x:Name="ErrorText" Style="{StaticResource Caption}" Foreground="#C42B1C" Margin="4,8,0,0" Visibility="Collapsed"/>

    <!-- Networks -->
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
      <StackPanel>
        <DockPanel Margin="4,0,0,6">
          <TextBlock x:Name="ScanText" DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
          <TextBlock Text="{local:T wifi.nearby}" FontWeight="Bold"/>
        </DockPanel>
        <StackPanel x:Name="NetworkList"/>
        <TextBlock x:Name="EmptyText" Text="{local:T wifi.empty}" Style="{StaticResource Caption}" Margin="4,4,0,0"/>

        <!-- Hidden network -->
        <Expander Header="{local:T wifi.hidden}" Margin="0,16,0,0" Foreground="{DynamicResource Text}">
          <StackPanel Margin="4,8,0,0">
            <TextBlock Text="{local:T wifi.ssid}" Style="{StaticResource Caption}"/>
            <TextBox x:Name="HiddenSsid" Padding="6,4" Margin="0,2,0,6"/>
            <TextBlock Text="{local:T wifi.password}" Style="{StaticResource Caption}"/>
            <PasswordBox x:Name="HiddenPassword" Padding="6,4" Margin="0,2,0,8"/>
            <Button Content="{local:T wifi.connect}" Style="{StaticResource Primary}" HorizontalAlignment="Left" Click="Hidden_Click"/>
          </StackPanel>
        </Expander>

        <!-- Saved networks -->
        <Expander Header="{local:T wifi.saved}" Margin="0,10,0,0" Foreground="{DynamicResource Text}">
          <StackPanel x:Name="SavedList" Margin="4,8,0,0"/>
        </Expander>
      </StackPanel>
    </ScrollViewer>

    <TextBlock Grid.Row="3" Text="{local:T wifi.note}" Style="{StaticResource Caption}" Margin="4,12,0,0"/>
  </Grid>
</Window>
