<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AetherDrop</AssemblyName>
    <RootNamespace>AetherDrop</RootNamespace>
    <Version>2.1.3</Version>
    <Product>AetherDrop</Product>
    <Description>AetherDrop: AirDrop for Windows</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../assets/AetherDrop.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="../assets/AetherDrop.ico" Link="Assets/AetherDrop.ico" />
    <Resource Include="../assets/AetherDrop-tray.ico" Link="Assets/AetherDrop-tray.ico" />
    <Resource Include="../assets/AetherDrop-logo.png" Link="Assets/AetherDrop-logo.png" />
    <Resource Include="../assets/AirDrop_logo_none.png" Link="Assets/AirDrop_logo_none.png" />
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
</Project>
