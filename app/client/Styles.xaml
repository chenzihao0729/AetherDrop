<!-- SPDX-License-Identifier: GPL-2.0-only
     The controls of the AetherDrop design (Windows 11 Fluent): cards, buttons,
     the toggle switch, pivot tabs, segmented switch, mode cards, text boxes,
     combo boxes and thin scroll bars. Colours come from Theme.cs. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:AetherDrop"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">

  <Style x:Key="ChoiceRow" TargetType="Button">
    <Setter Property="local:UiMotion.Enabled" Value="True"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Padding" Value="10,7"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="MinHeight" Value="32"/><Setter Property="FontSize" Value="12"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid Background="Transparent">
    <Border x:Name="SelectionWash" CornerRadius="7" Background="{DynamicResource AccentSubtle}" Opacity="0" IsHitTestVisible="False"/><Border x:Name="HoverWash" CornerRadius="7" Background="{DynamicResource CardHover}" Opacity="0" IsHitTestVisible="False"/><Border x:Name="PressWash" CornerRadius="7" Background="{DynamicResource PressTint}" Opacity="0" IsHitTestVisible="False"/><Border x:Name="FocusRing" CornerRadius="7" BorderBrush="{DynamicResource Accent}" BorderThickness="1" Opacity="0" IsHitTestVisible="False"/>
      <Grid Margin="{TemplateBinding Padding}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
        <TextBlock FontWeight="Normal" x:Name="SelectionMark" Grid.Column="1" Text="&#xE73E;" FontFamily="{DynamicResource IconFont}" FontSize="12" Foreground="{DynamicResource Accent}" Width="16" Margin="12,0,0,0" VerticalAlignment="Center" TextAlignment="Right" Opacity="0"/>
      </Grid></Grid><ControlTemplate.Triggers><Trigger Property="local:UiMotion.Selected" Value="True"><Setter Property="Foreground" Value="{DynamicResource Accent}"/><Setter Property="FontWeight" Value="Bold"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- Text -->
  <Style x:Key="T13" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
  </Style>
  <Style x:Key="T13S" TargetType="TextBlock" BasedOn="{StaticResource T13}">
    <Setter Property="FontWeight" Value="Bold"/>
  </Style>
  <Style x:Key="H14" TargetType="TextBlock" BasedOn="{StaticResource T13S}">
    <Setter Property="FontSize" Value="14"/>
  </Style>
  <Style x:Key="Sub12" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
    <Setter Property="LineHeight" Value="18"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="Dim11" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Foreground" Value="{DynamicResource Text3}"/>
  </Style>
  <Style x:Key="Icon" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource IconFont}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- A card -->
  <Style x:Key="WinCard" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Card}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
  </Style>
  <Style x:Key="Rule" TargetType="Border">
    <Setter Property="Height" Value="1"/>
    <Setter Property="Background" Value="{DynamicResource Border}"/>
  </Style>

  <!-- Buttons -->
  <Style x:Key="WinButton" TargetType="Button">
    <Setter Property="MinHeight" Value="{x:Static local:UiLayout.ControlHeight}"/>
    <Setter Property="local:UiMotion.Enabled" Value="True"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Background" Value="{DynamicResource Card}"/>
    <Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="10,6"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
    
    
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid Background="Transparent">
      <Border CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1"/>
      <Border x:Name="HoverWash" CornerRadius="6" Background="{DynamicResource CardHover}" Opacity="0" IsHitTestVisible="False"/><Border x:Name="PressWash" CornerRadius="6" Background="{DynamicResource PressTint}" Opacity="0" IsHitTestVisible="False"/><Border x:Name="FocusRing" CornerRadius="6" BorderBrush="{DynamicResource Accent}" BorderThickness="1" Opacity="0" IsHitTestVisible="False"/>
      <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" TextElement.Foreground="{TemplateBinding Foreground}"/>
    </Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="WinPrimary" TargetType="Button">
    <Setter Property="MinHeight" Value="{x:Static local:UiLayout.ControlHeight}"/>
    <Setter Property="local:UiMotion.Enabled" Value="True"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/><Setter Property="Background" Value="{DynamicResource Accent}"/>
    <Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="10,6"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
    
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid Background="Transparent">
      <Border CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1"/>
      <Border x:Name="HoverWash" CornerRadius="6" Background="#18FFFFFF" Opacity="0" IsHitTestVisible="False"/><Border x:Name="PressWash" CornerRadius="6" Background="{DynamicResource PressTint}" Opacity="0" IsHitTestVisible="False"/><Border x:Name="FocusRing" CornerRadius="6" BorderBrush="{DynamicResource Accent}" BorderThickness="1" Opacity="0" IsHitTestVisible="False"/>
      <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" TextElement.Foreground="{TemplateBinding Foreground}"/>
    </Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- Text only, in the accent (links) -->
  <Style x:Key="LinkButton" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="Transparent" Padding="{TemplateBinding Padding}">
            <TextBlock x:Name="t" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="t" Property="TextDecorations" Value="Underline"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="t" Property="TextDecorations" Value="Underline"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- Plain text button (no border), e.g. "Clear" -->
  <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource LinkButton}">
    <Setter Property="Foreground" Value="{DynamicResource Text3}"/>
    <Setter Property="Padding" Value="8,4"/>
  </Style>
  <!-- Title bar buttons (minimize, close, settings…) -->
  <Style x:Key="TitleButton" TargetType="Button">
    <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Foreground" Value="{DynamicResource Text2}"/><Setter Property="Background" Value="Transparent"/>
    <Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/><Setter Property="Padding" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid Background="Transparent">
      <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" TextElement.Foreground="{TemplateBinding Foreground}"/>
    </Grid><ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource Accent}"/></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.65"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
    </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="CloseTitleButton" TargetType="Button" BasedOn="{StaticResource TitleButton}">
    <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource Error}"/></Trigger></Style.Triggers>
  </Style>

  <!-- The Windows 11 toggle switch: 38 x 20, a 12 px knob that moves 18 px -->
  <Style x:Key="WinToggle" TargetType="CheckBox">
    <Setter Property="local:UiMotion.Enabled" Value="True"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Width="38" Height="20" Background="Transparent">
            <Border x:Name="track" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource BorderStrong}" Background="Transparent"/>
            <Ellipse x:Name="knob" Width="12" Height="12" HorizontalAlignment="Left" Margin="4,0,0,0" Fill="{DynamicResource Text2}">
              <Ellipse.RenderTransform><TranslateTransform x:Name="move" X="0"/></Ellipse.RenderTransform>
            </Ellipse>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="track" Property="Background" Value="{DynamicResource Accent}"/>
              <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource Accent}"/>
              <Setter TargetName="knob" Property="Fill" Value="{DynamicResource OnAccent}"/>

            </Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Settings tabs (pivot): text with a 2 px accent bar under the chosen one -->
  <Style x:Key="Pivot" TargetType="RadioButton">
    <Setter Property="local:UiMotion.Enabled" Value="True"/><Setter Property="Foreground" Value="{DynamicResource Text2}"/><Setter Property="FontSize" Value="13"/><Setter Property="Margin" Value="0,4,4,4"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Grid Background="Transparent">
      <Border x:Name="SelectionWash" CornerRadius="6" Background="{DynamicResource AccentSubtle}" Opacity="0"/>
      <Border x:Name="HoverWash" CornerRadius="6" Background="{DynamicResource CardHover}" Opacity="0"/>
      <Border x:Name="PressWash" CornerRadius="6" Background="{DynamicResource PressTint}" Opacity="0"/>
      <Border x:Name="FocusRing" CornerRadius="6" BorderBrush="{DynamicResource Accent}" BorderThickness="1" Opacity="0"/>
      <ContentPresenter Margin="8,8" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
    </Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{DynamicResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- Radar / list switch: a segment with an optional glyph in Tag -->
  <Style x:Key="Segment" TargetType="RadioButton">
    <Setter Property="local:UiMotion.Enabled" Value="True"/><Setter Property="Foreground" Value="{DynamicResource Text2}"/><Setter Property="FontSize" Value="12"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Grid Background="Transparent">
      <Border x:Name="SelectionWash" CornerRadius="6" Background="{DynamicResource AccentSubtle}" Opacity="0" IsHitTestVisible="False"/><Border x:Name="HoverWash" CornerRadius="6" Background="{DynamicResource CardHover}" Opacity="0" IsHitTestVisible="False"/><Border x:Name="PressWash" CornerRadius="6" Background="{DynamicResource PressTint}" Opacity="0" IsHitTestVisible="False"/><Border x:Name="FocusRing" CornerRadius="6" BorderBrush="{DynamicResource Accent}" BorderThickness="1" Opacity="0" IsHitTestVisible="False"/>
      <StackPanel Orientation="Horizontal" Margin="8,6"><ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/></StackPanel>
    </Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SegmentBox" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Card}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="2"/>
  </Style>

  <!-- A choice as a card (network modes): accent outline and tint when chosen.
       Content is the title, Tag the line below it. -->
  <Style x:Key="ModeCard" TargetType="RadioButton">
    <Setter Property="local:UiMotion.Enabled" Value="True"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Margin" Value="0,8,0,0"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Grid Background="Transparent">
      <Border CornerRadius="8" BorderBrush="{DynamicResource Border}" BorderThickness="1"/>
      <Border x:Name="SelectionWash" CornerRadius="8" Background="{DynamicResource AccentSubtle}" Opacity="0" IsHitTestVisible="False"/><Border x:Name="HoverWash" CornerRadius="8" Background="{DynamicResource CardHover}" Opacity="0" IsHitTestVisible="False"/><Border x:Name="PressWash" CornerRadius="8" Background="{DynamicResource PressTint}" Opacity="0" IsHitTestVisible="False"/><Border x:Name="FocusRing" CornerRadius="8" BorderBrush="{DynamicResource Accent}" BorderThickness="1" Opacity="0" IsHitTestVisible="False"/>
      <Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="{TemplateBinding Content}" FontSize="13" FontWeight="Bold" TextWrapping="Wrap"/><TextBlock Text="{TemplateBinding Tag}" FontSize="12" Foreground="{DynamicResource Text2}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
        <TextBlock FontWeight="Normal" x:Name="SelectionMark" Grid.Column="1" Text="&#xE73E;" FontFamily="{DynamicResource IconFont}" FontSize="14" Foreground="{DynamicResource Accent}" Width="16" Margin="12,0,0,0" VerticalAlignment="Center" Opacity="0"/>
      </Grid></Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- Color samples retain their color; the chosen sample gets a trailing check. -->
  <Style x:Key="Swatch" TargetType="RadioButton">
    <Setter Property="local:UiMotion.Enabled" Value="True"/><Setter Property="Margin" Value="0,0,6,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Grid Width="28" Height="28">
      <Border Background="{TemplateBinding Background}" CornerRadius="7" Margin="2"/>
      <Border x:Name="SelectionWash" CornerRadius="7" Background="{DynamicResource AccentSubtle}" Opacity="0" IsHitTestVisible="False"/><Border x:Name="HoverWash" CornerRadius="7" Background="#20FFFFFF" Opacity="0" IsHitTestVisible="False"/><Border x:Name="PressWash" CornerRadius="7" Background="#18000000" Opacity="0" IsHitTestVisible="False"/><Border x:Name="FocusRing" CornerRadius="7" BorderBrush="{DynamicResource Accent}" BorderThickness="1" Opacity="0" IsHitTestVisible="False"/>
      <Border x:Name="SelectionMark" Background="#D0202731" CornerRadius="4" Width="15" Height="15" HorizontalAlignment="Right" VerticalAlignment="Bottom" Opacity="0"><TextBlock FontFamily="{DynamicResource IconFont}" Text="&#xE73E;" Foreground="White" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    </Grid></ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- Text boxes -->
  <Style x:Key="WinTextBox" TargetType="TextBox">
    <Setter Property="local:UiMotion.Enabled" Value="True"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="CaretBrush" Value="{DynamicResource Text}"/><Setter Property="FontSize" Value="13"/><Setter Property="Padding" Value="10,5"/><Setter Property="MinHeight" Value="{x:Static local:UiLayout.ControlHeight}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Grid>
      <Border CornerRadius="7" BorderThickness="1" BorderBrush="{DynamicResource BorderStrong}" Background="Transparent"/>
      <Border x:Name="FocusRing" CornerRadius="7" BorderBrush="{DynamicResource Accent}" BorderThickness="1" Opacity="0" IsHitTestVisible="False"/>
      <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
    </Grid></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="WinPasswordBox" TargetType="PasswordBox">
    <Setter Property="local:UiMotion.Enabled" Value="True"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="CaretBrush" Value="{DynamicResource Text}"/><Setter Property="FontSize" Value="13"/><Setter Property="Padding" Value="10,5"/><Setter Property="MinHeight" Value="{x:Static local:UiLayout.ControlHeight}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox"><Grid>
      <Border CornerRadius="7" BorderThickness="1" BorderBrush="{DynamicResource BorderStrong}" Background="Transparent"/>
      <Border x:Name="FocusRing" CornerRadius="7" BorderBrush="{DynamicResource Accent}" BorderThickness="1" Opacity="0" IsHitTestVisible="False"/>
      <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
    </Grid></ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- Combo boxes: a bordered button and a Mica drop-down -->
  <Style x:Key="WinComboItem" TargetType="ComboBoxItem">
    <Setter Property="local:UiMotion.Enabled" Value="True"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="10,7"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Grid Margin="4,1">
      <Border x:Name="SelectionWash" CornerRadius="6" Background="{DynamicResource AccentSubtle}" Opacity="0" IsHitTestVisible="False"/><Border x:Name="HoverWash" CornerRadius="6" Background="{DynamicResource CardHover}" Opacity="0" IsHitTestVisible="False"/><Border x:Name="PressWash" CornerRadius="6" Background="{DynamicResource PressTint}" Opacity="0" IsHitTestVisible="False"/><Border x:Name="FocusRing" CornerRadius="6" BorderBrush="{DynamicResource Accent}" BorderThickness="1" Opacity="0" IsHitTestVisible="False"/>
      <Grid Margin="{TemplateBinding Padding}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/><TextBlock FontWeight="Normal" x:Name="SelectionMark" Grid.Column="1" FontFamily="{DynamicResource IconFont}" Text="&#xE73E;" FontSize="12" Foreground="{DynamicResource Accent}" Width="16" Margin="12,0,0,0" VerticalAlignment="Center" Opacity="0"/></Grid>
    </Grid></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="WinCombo" TargetType="ComboBox">
    <Setter Property="MinHeight" Value="{x:Static local:UiLayout.ControlHeight}"/>
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="ItemContainerStyle" Value="{StaticResource WinComboItem}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton local:UiMotion.Enabled="True" x:Name="toggle" Focusable="False" ClickMode="Press"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton"><Grid>
                  <Border CornerRadius="7" BorderThickness="1" BorderBrush="{DynamicResource BorderStrong}" Background="{DynamicResource MicaSolid}"/>
                  <Border x:Name="SelectionWash" CornerRadius="7" Background="{DynamicResource AccentSubtle}" Opacity="0"/>
                  <Border x:Name="HoverWash" CornerRadius="7" Background="{DynamicResource CardHover}" Opacity="0"/>
                  <Border x:Name="PressWash" CornerRadius="7" Background="{DynamicResource PressTint}" Opacity="0"/>
                </Grid></ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <DockPanel IsHitTestVisible="False" Margin="10,6,10,6">
              <TextBlock DockPanel.Dock="Right" FontFamily="{DynamicResource IconFont}" Text="&#xE70D;" FontSize="10"
                         VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource Text2}"/>
              <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
            </DockPanel>
            <Popup local:UiMotion.Popover="True" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
              <Border CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource BorderStrong}" Background="{DynamicResource MicaSolid}"
                      Padding="0,4" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Margin="0,4,0,0">
                <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                  <ItemsPresenter/>
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ContextMenu">
    <Setter Property="local:UiMotion.Entrance" Value="True"/><Setter Property="FontFamily" Value="{DynamicResource UiFont}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Background" Value="{DynamicResource MicaSolid}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu"><Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1" CornerRadius="10" Padding="5"><ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer></Border></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="MenuItem">
    <Setter Property="local:UiMotion.Enabled" Value="True"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="FontFamily" Value="{DynamicResource UiFont}"/><Setter Property="FontSize" Value="12"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem"><Grid Background="Transparent">
      <Border x:Name="SelectionWash" CornerRadius="6" Background="{DynamicResource AccentSubtle}" Opacity="0"/><Border x:Name="HoverWash" CornerRadius="6" Background="{DynamicResource CardHover}" Opacity="0"/>
      <Grid Margin="10,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ContentPresenter ContentSource="Header" VerticalAlignment="Center"/><TextBlock FontWeight="Normal" x:Name="SelectionMark" Grid.Column="1" FontFamily="{DynamicResource IconFont}" Text="&#xE73E;" FontSize="12" Width="16" Margin="12,0,0,0" Foreground="{DynamicResource Accent}" Opacity="0"/></Grid>
    </Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- Thin scroll bars (5 px thumb) -->
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="8"/>
    <Setter Property="MinWidth" Value="8"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Track x:Name="PART_Track" IsDirectionReversed="True">
            <Track.Thumb>
              <Thumb>
                <Thumb.Template>
                  <ControlTemplate TargetType="Thumb">
                    <Border CornerRadius="3" Width="5" Background="{DynamicResource BorderStrong}" HorizontalAlignment="Center"/>
                  </ControlTemplate>
                </Thumb.Template>
              </Thumb>
            </Track.Thumb>
          </Track>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Height" Value="8"/>
        <Setter Property="MinHeight" Value="8"/>
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Track x:Name="PART_Track">
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border CornerRadius="3" Height="5" Background="{DynamicResource BorderStrong}" VerticalAlignment="Center"/>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
