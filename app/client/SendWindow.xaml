<Window x:Class="NekoDrop.SendWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NekoDrop"
        Title="{local:T send.title}" Width="440" Height="460" MinWidth="380" MinHeight="380"
        Icon="{x:Static local:Branding.WindowIcon}"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True" AllowDrop="True"
        Background="{DynamicResource Window}" Foreground="{DynamicResource Text}"
        FontFamily="{DynamicResource UiFont}" FontSize="14">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="SettingsStyles.xaml"/></ResourceDictionary.MergedDictionaries>
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
    </Style>
    <Style x:Key="Subtle" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Background" Value="{DynamicResource Card}"/>
      <Setter Property="Padding" Value="20,6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource CardStroke}" BorderThickness="1"
                    CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource CardHover}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.8"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    </ResourceDictionary>
  </Window.Resources>

  <Grid Margin="20,16,20,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- What is being sent -->
    <Border Grid.Row="0" Background="{DynamicResource Card}" BorderBrush="{DynamicResource CardStroke}" BorderThickness="1"
            CornerRadius="8" Padding="12,10">
      <DockPanel>
        <Grid DockPanel.Dock="Left" Width="40" Height="40" Margin="0,0,12,0">
          <Rectangle RadiusX="6" RadiusY="6" Fill="{DynamicResource Accent}" Opacity="0.15"/>
          <TextBlock FontFamily="{DynamicResource IconFont}" Text="&#xE8A5;" FontSize="20" Foreground="{DynamicResource AccentText}"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="SummaryText" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="SizeText" Style="{StaticResource Caption}"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <TextBlock Grid.Row="1" Text="{local:T send.choose}" FontWeight="Bold" Margin="2,16,0,8"/>

    <Grid Grid.Row="2">
      <TextBlock x:Name="NoDevices" Text="{local:T send.none}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                 TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12"/>
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Devices}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Click="Device_Click" Tag="{Binding}" Margin="0,0,8,8" Cursor="Hand" Foreground="{DynamicResource Text}">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border x:Name="c" Width="120" Height="132" CornerRadius="8" Background="Transparent" Padding="6">
                      <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="c" Property="Background" Value="{DynamicResource CardHover}"/></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Button.Template>
                <StackPanel HorizontalAlignment="Center">
                  <Grid Width="60" Height="60" Margin="0,2,0,6">
                    <Ellipse Fill="{DynamicResource Accent}" Opacity="0.15"/>
                    <TextBlock FontFamily="{DynamicResource IconFont}" Text="{Binding Glyph}" FontSize="26"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AccentText}"/>
                  </Grid>
                  <TextBlock Text="{Binding Name}" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" TextAlignment="Center" TextWrapping="Wrap" MaxHeight="32"/>
                  <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="1" Height="3" Margin="8,4,8,0" BorderThickness="0"
                               Foreground="{DynamicResource Accent}" Background="{DynamicResource Divider}">
                    <ProgressBar.Style>
                      <Style TargetType="ProgressBar">
                        <Setter Property="Visibility" Value="Hidden"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Busy}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </ProgressBar.Style>
                  </ProgressBar>
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>

    <DockPanel Grid.Row="3" Margin="0,12,0,0">
      <Button DockPanel.Dock="Right" Content="{local:T send.close}" Style="{StaticResource Subtle}" Click="Close_Click" IsCancel="True"/>
      <TextBlock VerticalAlignment="Center">
        <Hyperlink Click="More_Click" Foreground="{DynamicResource AccentText}"><Run Text="{local:T send.more}"/></Hyperlink>
      </TextBlock>
    </DockPanel>
  </Grid>
</Window>
