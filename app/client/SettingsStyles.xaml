<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="Text" Color="{DynamicResource ToneColor1C2024}"/>
  <SolidColorBrush x:Key="TextSecondary" Color="{DynamicResource ToneColor6C737A}"/>
  <SolidColorBrush x:Key="Card" Color="{DynamicResource ToneColorFFFFFF}"/>
  <SolidColorBrush x:Key="CardStroke" Color="{DynamicResource ToneColorDFE7EE}"/>
  <SolidColorBrush x:Key="Accent" Color="{DynamicResource ToneColor007AFF}"/>
  <SolidColorBrush x:Key="InputStroke" Color="{DynamicResource ToneColorC7D2DD}"/>
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="10"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="ScrollBar">
        <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical">
          <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False" Opacity="0"/></Track.DecreaseRepeatButton>
          <Track.Thumb><Thumb MinHeight="28"><Thumb.Template><ControlTemplate TargetType="Thumb">
            <Border x:Name="Grip" Background="{DynamicResource ToneC5D1DC}" CornerRadius="3" Margin="2,3"/>
            <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="{DynamicResource Tone9EAFBE}"/></Trigger></ControlTemplate.Triggers>
          </ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
          <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False" Opacity="0"/></Track.IncreaseRepeatButton>
        </Track>
      </ControlTemplate>
    </Setter.Value></Setter>
  </Style>
  <Style x:Key="CardBox" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Card}"/>
    <Setter Property="BorderBrush" Value="{StaticResource CardStroke}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="Padding" Value="18,16"/>
    <Setter Property="Margin" Value="0,0,0,12"/>
  </Style>
  <Style TargetType="TextBlock">
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="Caption" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="LineHeight" Value="18"/>
    <Setter Property="Margin" Value="0,4,0,0"/>
  </Style>
  <Style TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource Text}"/>
    <Setter Property="Background" Value="{DynamicResource ToneF5F9FD}"/>
    <Setter Property="BorderBrush" Value="{StaticResource InputStroke}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="14,7"/>
    <Setter Property="MinHeight" Value="34"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
            <Grid>
              <Border x:Name="Hover" Background="{DynamicResource Tone007AFF}" Opacity="0" CornerRadius="6"/>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="0.08"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="0.18"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Tone007AFF}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{DynamicResource Tone007AFF}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Tone007AFF}"/>
    <Setter Property="Foreground" Value="White"/>
  </Style>
  <Style x:Key="ChromeButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Width" Value="30"/><Setter Property="Height" Value="30"/>
    <Setter Property="MinHeight" Value="0"/><Setter Property="Padding" Value="0"/>
    <Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style TargetType="TextBox">
    <Setter Property="Background" Value="{DynamicResource ToneF8FBFE}"/>
    <Setter Property="Foreground" Value="{StaticResource Text}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource Tone007AFF}"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource ToneB8D9FF}"/>
    <Setter Property="BorderBrush" Value="{StaticResource InputStroke}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="10,7"/><Setter Property="MinHeight" Value="36"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="TextBox">
        <Border x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7">
          <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource Tone007AFF}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Field" Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter.Value></Setter>
  </Style>
  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource Text}"/>
    <Setter Property="Margin" Value="0,10,0,0"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="CheckBox">
        <Grid Background="Transparent">
          <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Border x:Name="Mark" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="4" Background="{DynamicResource ToneF8FBFE}" BorderBrush="{DynamicResource ToneBCCBD8}" BorderThickness="1">
            <Path x:Name="Check" Data="M 2,6 L 5,9 L 11,2" Stroke="White" StrokeThickness="1.7" Width="12" Height="11" Visibility="Collapsed"/>
          </Border>
          <ContentPresenter Grid.Column="1" VerticalAlignment="Center" RecognizesAccessKey="True"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Mark" Property="Background" Value="{DynamicResource Tone007AFF}"/><Setter TargetName="Mark" Property="BorderBrush" Value="{DynamicResource Tone007AFF}"/><Setter TargetName="Check" Property="Visibility" Value="Visible"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Mark" Property="BorderBrush" Value="{DynamicResource Tone007AFF}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter.Value></Setter>
  </Style>
  <Style TargetType="RadioButton">
    <Setter Property="Foreground" Value="{StaticResource Text}"/>
    <Setter Property="Margin" Value="0,12,0,0"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="RadioButton">
        <Grid Background="Transparent">
          <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Border x:Name="Radio" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="8" Background="{DynamicResource ToneFFFFFF}" BorderBrush="{DynamicResource ToneBCCBD8}" BorderThickness="1">
            <Ellipse x:Name="Dot" Fill="White" Width="6" Height="6" Visibility="Collapsed"/>
          </Border>
          <ContentPresenter Grid.Column="1" VerticalAlignment="Center" RecognizesAccessKey="True"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Radio" Property="Background" Value="{DynamicResource Tone007AFF}"/><Setter TargetName="Radio" Property="BorderBrush" Value="{DynamicResource Tone007AFF}"/><Setter TargetName="Dot" Property="Visibility" Value="Visible"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Radio" Property="BorderBrush" Value="{DynamicResource Tone007AFF}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter.Value></Setter>
  </Style>
  <Style TargetType="ListBox">
    <Setter Property="Background" Value="{DynamicResource ToneF8FBFE}"/><Setter Property="Foreground" Value="{StaticResource Text}"/>
    <Setter Property="BorderBrush" Value="{StaticResource InputStroke}"/><Setter Property="Padding" Value="6"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox">
      <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
        <ScrollViewer Focusable="False"><ItemsPresenter/></ScrollViewer>
      </Border>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource Tone1C2024}"/><Setter Property="Padding" Value="10,7"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
      <Border x:Name="Choice" CornerRadius="5" Padding="{TemplateBinding Padding}" Background="Transparent"><ContentPresenter/></Border>
      <ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Choice" Property="Background" Value="{DynamicResource ToneE6F1FF}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Choice" Property="Background" Value="{DynamicResource ToneD6E8FF}"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox">
    <Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="MinHeight" Value="36"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
      <Grid>
        <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press">
          <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
            <Border Background="{DynamicResource ToneF8FBFE}" BorderBrush="{DynamicResource ToneC7D2DD}" BorderThickness="1" CornerRadius="7">
              <Path Data="M 0,0 L 4,4 L 8,0" Width="8" Height="4" Stroke="{DynamicResource Tone6C737A}" StrokeThickness="1.5" HorizontalAlignment="Right" Margin="0,0,12,0"/>
            </Border>
          </ControlTemplate></ToggleButton.Template>
        </ToggleButton>
        <ContentPresenter Margin="10,5,32,5" VerticalAlignment="Center" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
        <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
          <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="300" Background="{DynamicResource ToneFFFFFF}" BorderBrush="{DynamicResource ToneC7D2DD}" BorderThickness="1" CornerRadius="8" Padding="4" Margin="0,4,0,0">
            <ScrollViewer CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
          </Border>
        </Popup>
      </Grid>
      <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="PasswordBox">
    <Setter Property="Background" Value="{DynamicResource ToneF8FBFE}"/><Setter Property="Foreground" Value="{DynamicResource Tone1C2024}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ToneC7D2DD}"/><Setter Property="CaretBrush" Value="{DynamicResource Tone007AFF}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox">
      <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></Border>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
